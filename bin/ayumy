#!/usr/bin/env bash
set -euo pipefail

AYUMY_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage: ayumy <command> [options]

Commands:
  sync          Sync Claude Code sessions to the host machine
  setup-hooks   Install post-commit hook to Git repositories
  setup-host    Set up the host machine (env file, container, cron)
USAGE
  exit 1
}

[[ $# -eq 0 ]] && usage

command="$1"
shift

case "$command" in
  sync)
    exec "$AYUMY_ROOT/scripts/sync_session.sh" "$@"
    ;;
  setup-hooks)
    exec "$AYUMY_ROOT/scripts/setup_hooks.sh" "$@"
    ;;
  setup-host)
    exec "$AYUMY_ROOT/scripts/setup_host.sh" "$@"
    ;;
  *)
    echo "ayumy: unknown command '$command'" >&2
    usage
    ;;
esac
