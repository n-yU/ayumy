#!/usr/bin/env bash
set -euo pipefail

AYUMY_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  local code="${1:-1}"
  local dest=1
  [[ "$code" -ne 0 ]] && dest=2
  cat >&"$dest" <<'USAGE'
Usage: ayumy <command> [options]

Commands:
  sync          Sync Claude Code sessions to S3
  setup-hooks   Install pre-push hook to current repository

Options:
  -h, --help    Show this help message
USAGE
  exit "$code"
}

[[ $# -eq 0 ]] && usage

case "$1" in
  -h|--help)
    usage 0
    ;;
esac

command="$1"
shift

case "$command" in
  sync)
    exec "$AYUMY_ROOT/scripts/sync_session.sh" "$@"
    ;;
  setup-hooks)
    exec "$AYUMY_ROOT/scripts/setup_hooks.sh" "$@"
    ;;
  *)
    echo "ayumy: unknown command '$command'" >&2
    usage
    ;;
esac
